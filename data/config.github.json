{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "bitcoin",
        "repo": "bitcoin",
        "enabled": true,
        "category": "crypto-protocols"
      },
      {
        "type": "repo_releases",
        "owner": "ethereum",
        "repo": "go-ethereum",
        "enabled": true,
        "category": "crypto-protocols"
      },
      {
        "type": "repo_releases",
        "owner": "anza-xyz",
        "repo": "agave",
        "enabled": true,
        "category": "crypto-protocols"
      },
      {
        "type": "repo_releases",
        "owner": "lightningnetwork",
        "repo": "lnd",
        "enabled": true,
        "category": "crypto-protocols"
      },
      {
        "type": "repo_releases",
        "owner": "cosmos",
        "repo": "cosmos-sdk",
        "enabled": true,
        "category": "crypto-protocols"
      },
      {
        "type": "repo_releases",
        "owner": "ava-labs",
        "repo": "avalanchego",
        "enabled": true,
        "category": "crypto-protocols"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 120,
      "category": "tech-community"
    },
    "rss": [
      {
        "name": "CoinDesk",
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "enabled": true,
        "category": "crypto-markets"
      },
      {
        "name": "Decrypt",
        "url": "https://decrypt.co/feed",
        "enabled": true,
        "category": "crypto-markets"
      },
      {
        "name": "Cointelegraph",
        "url": "https://cointelegraph.com/rss",
        "enabled": true,
        "category": "crypto-markets"
      },
      {
        "name": "Bitcoin Magazine",
        "url": "https://bitcoinmagazine.com/.rss/full/",
        "enabled": true,
        "category": "crypto-protocols"
      },
      {
        "name": "Kraken Blog",
        "url": "https://blog.kraken.com/feed",
        "enabled": true,
        "category": "exchange-announcements"
      },
      {
        "name": "Coinbase Status",
        "url": "https://status.coinbase.com/history.rss",
        "enabled": true,
        "category": "exchange-operations"
      },
      {
        "name": "Kraken Status",
        "url": "https://status.kraken.com/history.rss",
        "enabled": true,
        "category": "exchange-operations"
      },
      {
        "name": "Federal Reserve Press Releases",
        "url": "https://www.federalreserve.gov/feeds/press_all.xml",
        "enabled": true,
        "category": "macro-regulation"
      },
      {
        "name": "SEC Press Releases",
        "url": "https://www.sec.gov/news/pressreleases.rss",
        "enabled": true,
        "category": "crypto-regulation"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "devtools"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "CryptoCurrency",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 100,
          "category": "crypto-markets"
        },
        {
          "subreddit": "Bitcoin",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 80,
          "category": "crypto-protocols"
        },
        {
          "subreddit": "ethereum",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 50,
          "category": "crypto-protocols"
        },
        {
          "subreddit": "defi",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 25,
          "category": "crypto-protocols"
        },
        {
          "subreddit": "CryptoMarkets",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 25,
          "category": "crypto-markets"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "binance_announcements",
          "enabled": true,
          "fetch_limit": 12,
          "category": "exchange-announcements"
        },
        {
          "channel": "OKXAnnouncements",
          "enabled": true,
          "fetch_limit": 12,
          "category": "exchange-announcements"
        },
        {
          "channel": "Bybit_Announcements",
          "enabled": true,
          "fetch_limit": 12,
          "category": "exchange-announcements"
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Rust",
        "Go"
      ],
      "keywords": [
        "bitcoin",
        "ethereum",
        "solana",
        "blockchain",
        "crypto",
        "defi",
        "stablecoin",
        "wallet",
        "zero knowledge",
        "zk"
      ],
      "min_stars": 5,
      "max_items": 15,
      "category": "crypto-protocols"
    },
    "gdelt": {
      "enabled": true,
      "query": "(cryptocurrency OR bitcoin OR ethereum OR stablecoin OR blockchain)",
      "mode": "ArtList",
      "max_records": 35,
      "timespan": "24h",
      "language": "english",
      "country": null,
      "category": "crypto-markets"
    },
    "google_news": {
      "enabled": true,
      "query": "(Binance OR OKX OR Bybit OR Coinbase OR Kraken) (listing OR delisting OR maintenance OR security OR regulation)",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 40,
      "category": "exchange-announcements"
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "daily_timezone": "Asia/Shanghai",
    "preserve_daily_items": true,
    "max_items": 24,
    "category_groups": {
      "exchange": {
        "name": "Exchange Announcements",
        "limit": 7,
        "categories": [
          "exchange-announcements",
          "exchange-operations"
        ]
      },
      "markets": {
        "name": "Crypto Markets",
        "limit": 6,
        "categories": [
          "crypto-markets"
        ]
      },
      "protocols": {
        "name": "Protocols and On-chain",
        "limit": 5,
        "categories": [
          "crypto-protocols"
        ]
      },
      "regulation": {
        "name": "Regulation and Macro",
        "limit": 4,
        "categories": [
          "crypto-regulation",
          "macro-regulation"
        ]
      },
      "technology": {
        "name": "Technology",
        "limit": 2,
        "categories": [
          "tech-community",
          "devtools"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
